# Copy this file to .env (for the server) AND to client/.env (for the Vite dev server /
# production build) -- see README.md "Local Development" for the full walkthrough.
# Never put real secrets in this file; it is committed to the repository as a template.

# Port the Express API listens on.
PORT=4000

# development | production | test -- production requires a real JWT_SECRET (no fallback).
NODE_ENV=development

# MongoDB connection string. For local development, either:
#   - a local MongoDB server:    mongodb://localhost:27017/cubecoach
#   - a MongoDB Atlas cluster:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cubecoach
# See README.md "MongoDB Setup" for step-by-step Atlas instructions.
MONGODB_URI=mongodb://localhost:27017/cubecoach

# Secret used to sign/verify JWTs. Generate one locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required (no fallback) when NODE_ENV=production.
JWT_SECRET=replace_with_a_generated_secret

# Frontend origin the server's CORS policy allows. Must match where the Vite dev
# server (or built client) is actually served from.
CLIENT_URL=http://localhost:5173

# Base URL the frontend calls for the API. Only this variable (VITE_-prefixed) is read
# by Vite -- it must also be present in client/.env, not just the root .env.
VITE_API_URL=http://localhost:4000/api
